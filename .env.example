# =============================================================================
# NAS System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key
WTF_CSRF_SECRET_KEY=change-me-to-another-random-key
SECURITY_PASSWORD_SALT=change-me-to-a-unique-salt

# --- Database ---
# SQLite (default — no config needed):
#   DATABASE_URL=sqlite:///nas.db
# PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/nas_database
# MySQL:
#   DATABASE_URL=mysql://user:password@localhost:3306/nas_database
DATABASE_URL=

# --- Storage ---
# Default storage limit per user in GB
DEFAULT_STORAGE_LIMIT_GB=50

# --- Email (optional) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=NAS System <noreply@example.com>

# --- Redis (optional) ---
# Enables shared rate limiting across workers and across restarts.
# Leave blank to use the built-in in-memory limiter.
# Docker Compose sets this automatically to redis://redis:6379/0
REDIS_URL=

# --- Updates / Version Checking ---
# Set to "owner/repo" (e.g. "myusername/nas-system") to enable in-app
# update checks against GitHub releases. Leave blank to disable.
GITHUB_REPO=

# --- Session ---
# Set to True only when serving over HTTPS
SESSION_COOKIE_SECURE=False

# --- Initial Admin Account ---
# Used by the setup wizard if provided. Leave blank to set via the UI.
# Password MUST be at least 8 chars and contain a letter and a number.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Demo Account (optional) ---
# If set, a demo user will be available for testing purposes.
DEMO_USERNAME=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoPass123!

# --- Account Activation ---
# Mode: "admin_approval" (default), "email_verification", "both", "none"
ACCOUNT_ACTIVATION_MODE=admin_approval

# --- AI Service (optional, disabled by default) ---
AI_API_URL=http://localhost:8000/summarize
